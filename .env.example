# Environment variables for Meeting Summarizer
# Copy this file to .env and fill in your API key.

# API key — supports OpenAI or OpenRouter keys
OPENAI_API_KEY=sk-your-api-key-here

# Base URL — defaults to OpenRouter. Set to https://api.openai.com/v1 for direct OpenAI.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
